      "method": "exportWorkspace",
      "request": {
        "v": 1,
        "id": "9",
        "capability": "filesystem",
        "method": "exportWorkspace",
        "params": {}
      },
      "response": {
        "v": 1,
        "id": "9",
        "ok": false,
        "error": { "code": "denied", "message": "the server refused the export (403)" }
