{
  "capability": "auth",
  "note": "auth is app-boot plumbing and is deliberately NOT exposed through kernel.capabilities (BRIDGE.md §4.1): a plugin has no business reading the session token from an API that looks like a feature. The web side touches it only through window.shell.bearerToken / setBearerToken in the boot sequence.",
  "cases": [
    {
      "name": "getToken, signed in",
      "method": "getToken",
      "request": { "v": 1, "id": "1", "capability": "auth", "method": "getToken", "params": {} },
      "response": { "v": 1, "id": "1", "ok": true, "result": "lm.session.Ax9…" }
    },
    {
      "name": "getToken, never signed in",
      "method": "getToken",
      "request": { "v": 1, "id": "2", "capability": "auth", "method": "getToken", "params": {} },
      "response": { "v": 1, "id": "2", "ok": true, "result": null }
    },
    {
      "name": "setToken after the page logged in itself",
      "note": "The re-auth path of SPEC §5.3: the page gets a new bearer token and hands it to the keystore. The keystore key is lm.bearer-token and changing it signs every device out (BRIDGE.md §9).",
      "method": "setToken",
      "request": {
        "v": 1,
        "id": "3",
        "capability": "auth",
        "method": "setToken",
        "params": { "token": "lm.session.Bz1…" }
      },
      "response": { "v": 1, "id": "3", "ok": true, "result": null }
    },
    {
      "name": "setToken with no token",
      "method": "setToken",
      "request": { "v": 1, "id": "4", "capability": "auth", "method": "setToken", "params": {} },
      "response": {
        "v": 1,
        "id": "4",
        "ok": false,
        "error": { "code": "invalid", "message": "token is required" }
      }
    },
    {
      "name": "clearToken on sign-out",
      "method": "clearToken",
      "request": { "v": 1, "id": "5", "capability": "auth", "method": "clearToken", "params": {} },
      "response": { "v": 1, "id": "5", "ok": true, "result": null }
    }
  ]
}
