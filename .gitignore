# Secrets: `.env.example` is the committed template, `.env` never is.
.env
.env.*
!.env.example

# `mise run backup` writes dumps here.
/backups/

# Rust build output (the crates have their own ignores too).
/target
# M4: the wasm plugin workspace and the wasm-only SDK crate build outside `backend/`.
/plugins/target/
/backend/crates/plugin-sdk/target/

# Web build output and dependencies.
node_modules/
/web/dist/
# M3 build output: the PWA bundle, the generated plugin contract, and the built base
# plugin distribution (the *sources* are committed; `plugins/base/*/dist` is what
# `mise run plugins` produces and what the server serves as PLUGINS_DIR).
/web/app/dist/
/web/kernel-api/dist/
/plugins/base/dist/
/plugins/base/*/dist/
# The example plugins (`plugins/examples/*`) build the same way; the composed
# registry directories the app E2E suite serves are derived from both dists.
/plugins/examples/dist/
/plugins/examples/*/dist/
# M4: an operator's drop directory and the installer's staging area, if either is
# configured inside the repository during development.
/plugins/inbox/
/plugins/base/dist.staging/
/web/app/e2e/.plugins/
/web/test-results/
/web/playwright-report/
# Playwright MCP scratch output (snapshots, console logs) from driving the demo.
.playwright-mcp/

# Generated by `mise run wasm` — a build artifact, never committed (SPEC §2:
# the Wasm core is built from backend/crates/core, not vendored).
/web/kernel/src/wasm/pkg/

# `mise run plugin-package` output — installable plugin `.zip`s, rebuilt from the
# `plugins/base/dist` layout whenever they are needed.
/dist-packages/
