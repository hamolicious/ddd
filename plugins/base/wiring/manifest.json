{
  "id": "wiring",
  "version": "1.0.0",
  "name": "Wiring",
  "description": "The wiring editor: every plugin's ports and the wires between them, drafts, Apply, history and rollback (PLUGIN-PROTOCOLS §7).",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": {
    "prefix": "wiring"
  },
  "kernel": "^2.0",
  "hot": true,
  "consumes": {
    "router": {
      "protocol": "lm/router@^1.0",
      "needs": [
        "navigate",
        "current",
        "onChange"
      ]
    },
    "shell": {
      "protocol": "lm/shell@^1.0",
      "needs": [
        "layout",
        "subscribeLayout",
        "toggleAltbar"
      ]
    },
    "menu": {
      "protocol": "lm/context-menu@^1.0",
      "needs": [
        "confirm",
        "modal",
        "openSheet",
        "close"
      ]
    }
  },
  "provides": {
    "route": {
      "protocol": "lm/router.route@1.0.0"
    },
    "view": {
      "protocol": "lm/main.view@1.0.0"
    },
    "panel": {
      "protocol": "lm/altbar.panel@1.0.0",
      "order": 60
    },
    "commands": {
      "protocol": "lm/commands.command@1.0.0"
    }
  },
  "peerLibraries": {
    "react": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  }
}
