{
  "id": "viewer",
  "version": "1.0.0",
  "name": "Viewer",
  "description": "Read mode: renders the body, hides frontmatter and machine sections.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": true,
  "kernel": "^2.0",
  "hot": true,
  "consumes": {
    "markdown": {
      "protocol": "lm/markdown-renderer@^1.0",
      "needs": [
        "render",
        "bodyOf",
        "renderAttachment"
      ]
    }
  },
  "provides": {
    "mode": {
      "protocol": "lm/document.mode@1.0.0",
      "order": 0
    },
    "view": {
      "protocol": "lm/main.view@1.0.0"
    },
    "route": {
      "protocol": "lm/router.route@1.0.0"
    }
  },
  "peerLibraries": {
    "react": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  }
}
