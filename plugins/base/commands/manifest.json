{
  "id": "commands",
  "version": "1.0.0",
  "name": "Commands",
  "description": "Command registry, palette (Mod+K) and per-user keybindings.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": true,
  "kernel": "^1.0",
  "hot": true,
  "consumes": {
    "commands": {
      "protocol": "lm/commands.command@^1.0"
    },
    "keys": {
      "protocol": "lm/keybindings.default@^1.0"
    }
  },
  "provides": {
    "own": {
      "protocol": "lm/commands.command@1.0.0"
    },
    "own-keys": {
      "protocol": "lm/keybindings.default@1.0.0"
    },
    "palette": {
      "protocol": "lm/shell.overlay@1.0.0"
    },
    "settings": {
      "protocol": "lm/settings.section@1.0.0",
      "order": 200
    }
  },
  "dependencies": {
    "shell-ui": "^1.0"
  },
  "peerLibraries": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  },
  "x-defines": [
    "commands.command",
    "keybindings.default"
  ]
}
