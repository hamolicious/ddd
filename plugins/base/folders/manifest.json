{
  "id": "folders",
  "version": "1.0.0",
  "name": "Folders",
  "description": "A drag-and-drop file tree over fm.path; every move is a frontmatter splice.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": true,
  "kernel": "^2.0",
  "hot": true,
  "consumes": {
    "browser": {
      "protocol": "lm/document-browser@^1.0",
      "needs": [
        "newDocument"
      ]
    },
    "router": {
      "protocol": "lm/router@^1.0",
      "needs": [
        "navigate",
        "current",
        "onChange"
      ]
    },
    "menu": {
      "protocol": "lm/context-menu@^1.0",
      "needs": [
        "open",
        "openSheet",
        "confirm",
        "close"
      ]
    }
  },
  "provides": {
    "tree": {
      "protocol": "lm/sidebar.panel@1.0.0",
      "order": 20
    },
    "route": {
      "protocol": "lm/router.route@1.0.0"
    },
    "view": {
      "protocol": "lm/main.view@1.0.0"
    },
    "settings": {
      "protocol": "lm/settings.section@1.0.0",
      "order": 30
    },
    "commands": {
      "protocol": "lm/commands.command@1.0.0"
    },
    "location": {
      "protocol": "lm/folders.default-location@1.0.0"
    }
  },
  "peerLibraries": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  }
}
