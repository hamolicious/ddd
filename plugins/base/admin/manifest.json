{
  "id": "admin",
  "version": "1.0.0",
  "name": "Admin",
  "description": "Users, invites, audit log, orphan files, and the plugin list.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": true,
  "kernel": "^2.0",
  "hot": true,
  "consumes": {
    "router": {
      "protocol": "lm/router@^1.0",
      "needs": [
        "navigate",
        "current",
        "onChange",
        "match",
        "href",
        "url"
      ]
    },
    "menu": {
      "protocol": "lm/context-menu@^1.0",
      "needs": [
        "open",
        "openSheet",
        "modal",
        "confirm"
      ]
    }
  },
  "provides": {
    "route": {
      "protocol": "lm/router.route@1.0.0"
    },
    "view": {
      "protocol": "lm/main.view@1.0.0"
    },
    "settings": {
      "protocol": "lm/settings.section@1.0.0",
      "order": 900
    },
    "nav": {
      "protocol": "lm/navbar.item@1.0.0",
      "order": 90
    },
    "commands": {
      "protocol": "lm/commands.command@1.0.0"
    }
  },
  "peerLibraries": {
    "react": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  }
}
