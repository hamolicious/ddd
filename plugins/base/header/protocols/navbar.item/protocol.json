{
  "id": "lm/navbar.item",
  "version": "1.0.0",
  "kind": "slot",
  "owner": "header",
  "types": "index.d.ts",
  "description": "One item in the top bar, placed in one of the header's two sides. `component` renders it; `onSelect` is the shorthand for the common case, a button that runs a command.",
  "key": "id",
  "shape": {
    "object": {
      "id": "string",
      "label": "string",
      "icon": {
        "optional": "any"
      },
      "order": {
        "optional": "number"
      },
      "side": {
        "optional": {
          "literal": [
            "start",
            "end"
          ]
        }
      },
      "onSelect": {
        "optional": "func"
      },
      "component": {
        "optional": "component"
      }
    }
  }
}
