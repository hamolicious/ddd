{
  "id": "themes",
  "version": "1.0.0",
  "name": "Themes",
  "description": "Theme registry and picker; overrides the kernel's default tokens.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": true,
  "kernel": "^2.0",
  "hot": true,
  "consumes": {
    "themes": {
      "protocol": "lm/themes.theme@^1.0"
    },
    "settings-shell": {
      "protocol": "lm/settings-shell@^1.0",
      "needs": [
        "open"
      ],
      "optional": true
    }
  },
  "provides": {
    "builtin": {
      "protocol": "lm/themes.theme@1.0.0"
    },
    "commands": {
      "protocol": "lm/commands.command@2.0.0"
    },
    "settings": {
      "protocol": "lm/settings.section@1.0.0",
      "order": 10
    }
  },
  "peerLibraries": {
    "react": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  }
}
