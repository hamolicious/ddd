{
  "id": "github-packages",
  "version": "1.0.0",
  "name": "GitHub packages",
  "description": "A package source for Admin → Plugins: browse, install and update plugins from the .zip assets of a GitHub repository's releases.",
  "author": "ddd base distribution",
  "license": "MIT OR Apache-2.0",
  "kernel": "^3.0",
  "dependencies": {
    "admin": "^3.1"
  },
  "peerLibraries": {
    "react": "^18.0.0"
  },
  "capabilities": {
    "http": {
      "hosts": ["api.github.com", "release-assets.githubusercontent.com", "objects.githubusercontent.com"]
    }
  },
  "frontend": {
    "module": "frontend/index.mjs"
  },
  "backend": {
    "module": "backend.wasm",
    "routes": ["POST /download"]
  }
}
