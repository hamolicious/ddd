{
  "id": "markdown",
  "version": "1.0.0",
  "name": "Markdown",
  "description": "The unified/remark to React pipeline, and the extension points over it.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": true,
  "kernel": "^1.0",
  "consumes": {
    "router": {
      "protocol": "lm/router@^1.0",
      "needs": [
        "navigate",
        "current",
        "onChange",
        "href",
        "url"
      ],
      "optional": true
    },
    "attachments": {
      "protocol": "lm/markdown.attachment@^1.0"
    },
    "code": {
      "protocol": "lm/markdown.codeBlock@^1.0"
    },
    "tasks": {
      "protocol": "lm/markdown.taskState@^1.0"
    },
    "directives": {
      "protocol": "lm/markdown.directive@^1.0"
    },
    "fences": {
      "protocol": "lm/markdown.fence@^1.0"
    },
    "remark": {
      "protocol": "lm/markdown.remark@^1.0"
    },
    "components": {
      "protocol": "lm/markdown.component@^1.0"
    }
  },
  "provides": {
    "renderer": {
      "protocol": "lm/markdown-renderer@1.0.0"
    },
    "task-states": {
      "protocol": "lm/markdown.taskState@1.0.0",
      "order": 0
    },
    "settings": {
      "protocol": "lm/settings.section@1.0.0",
      "order": 45
    },
    "commands": {
      "protocol": "lm/commands.command@1.0.0"
    }
  },
  "dependencies": {
    "commands": "^1.0",
    "router": "^1.0"
  },
  "peerLibraries": {
    "react": "^18.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  },
  "x-defines": [
    "markdown.attachment",
    "markdown.codeBlock",
    "markdown.component",
    "markdown.directive",
    "markdown.fence",
    "markdown.remark",
    "markdown.taskState"
  ]
}
