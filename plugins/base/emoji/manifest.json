{
  "id": "emoji",
  "version": "1.0.0",
  "name": "Emoji",
  "description": "Writes :shortcode: as its emoji in read mode, and suggests shortcodes as you type one.",
  "author": "Life Manager base distribution",
  "license": "MIT OR Apache-2.0",
  "x-tailwind": {
    "prefix": "emoji"
  },
  "kernel": "^2.0",
  "hot": true,
  "consumes": {
    "surfaces": {
      "protocol": "lm/text.surface@^1.0"
    }
  },
  "provides": {
    "shortcodes": {
      "protocol": "lm/markdown.remark@1.0.0"
    },
    "popup": {
      "protocol": "lm/shell.overlay@1.0.0"
    }
  },
  "peerLibraries": {
    "react": "^18.0.0"
  },
  "frontend": {
    "module": "frontend/index.mjs",
    "style": "frontend/style.css"
  }
}
