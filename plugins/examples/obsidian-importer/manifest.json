{
  "id": "obsidian-importer",
  "version": "1.4.2",
  "kernel": "^1.0",
  "hot": true,
  "consumes": {
    "attachments": {
      "protocol": "lm/attachments@^1.0",
      "needs": [
        "upload"
      ]
    }
  },
  "provides": {
    "command": {
      "protocol": "lm/commands.command@1.0.0"
    },
    "nav": {
      "protocol": "lm/navbar.item@1.0.0",
      "order": 85
    }
  },
  "dependencies": {
    "attachments": "^1.1.0",
    "commands": "^1.0"
  },
  "frontend": {
    "module": "frontend/index.mjs"
  },
  "name": "Obsidian importer",
  "description": "Imports notes and attachments from an Obsidian vault ZIP, preserving paths and resolving links.",
  "author": "Life Manager examples",
  "license": "MIT OR Apache-2.0"
}
