{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-manager.dev/schema/manifest.schema.json",
  "title": "PluginManifest",
  "description": "A plugin's manifest.json (SPEC §6.2). The one source for the Rust and TypeScript manifest types and validators: `node web/scripts/gen-manifest.mjs` writes both, and `--check` fails when either is stale.",
  "x-kernel-version": "3.1.0",
  "x-rust-name": "PluginManifest",
  "x-rust-derive": [
    "Debug",
    "Clone",
    "Default",
    "PartialEq",
    "Serialize",
    "Deserialize"
  ],
  "x-rust-extra": true,
  "x-removed": {
    "consumes": "was removed in @kernel 3.0: import what you use from `plugin:<id>` and list the plugin under `dependencies`",
    "hot": "was removed in @kernel 3.0: every plugin change reloads the app",
    "x-defines": "was removed in @kernel 2.0: export a registration function (`addItem`) instead"
  },
  "type": "object",
  "required": [
    "id",
    "version",
    "kernel"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "plugin-id",
      "description": "`^[a-z0-9][a-z0-9-]{0,63}$`, also the URL segment under `/plugins/`."
    },
    "version": {
      "type": "string",
      "format": "semver",
      "description": "`1.2.3` with an optional prerelease/build tail."
    },
    "kernel": {
      "type": "string",
      "format": "semver-range",
      "description": "Semver range against the `@kernel` contract version."
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "format": "plugin-id"
      },
      "additionalProperties": {
        "type": "string",
        "format": "semver-range"
      },
      "description": "Plugin id → semver range. Each one loads before this plugin, and this plugin is skipped when one is missing, out of range or failed. Its exports are importable as `plugin:<id>`."
    },
    "optionalDependencies": {
      "type": "object",
      "propertyNames": {
        "format": "plugin-id"
      },
      "additionalProperties": {
        "type": "string",
        "format": "semver-range"
      },
      "description": "Like `dependencies`, but this plugin still loads without them. Reach one through `kernel.plugins.optional(id)`, never a static import."
    },
    "provides": {
      "type": "string",
      "format": "plugin-ref",
      "description": "`<id>@<version>`: this plugin stands in for another one at that API version. `plugin:<id>` resolves to whichever of the two is enabled; only one may be."
    },
    "peerLibraries": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "semver-range"
      },
      "description": "Blessed runtime-layer libraries and their ranges (SPEC §6.4)."
    },
    "frontend": {
      "$ref": "#/$defs/PluginFrontend",
      "description": "The frontend half."
    },
    "capabilities": {
      "$ref": "#/$defs/PluginCapabilities",
      "x-rust-default": true,
      "x-rust-skip-if": "PluginCapabilities::is_empty",
      "description": "The capability set a manifest requests (SPEC §6.2)."
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PluginConfigField"
      },
      "description": "The admin-config schema (SPEC §6.2). Values live in `plugin_config`; this is only their declaration."
    },
    "backend": {
      "$ref": "#/$defs/PluginBackend",
      "description": "The backend half: module, hooks, cron, routes, event subscriptions."
    },
    "name": {
      "type": "string",
      "description": "Human metadata; never load-bearing."
    },
    "description": {
      "type": "string",
      "description": "Human metadata; never load-bearing."
    },
    "author": {
      "type": "string",
      "description": "Human metadata; never load-bearing."
    },
    "license": {
      "type": "string",
      "description": "Human metadata; never load-bearing."
    }
  },
  "$defs": {
    "PluginFrontend": {
      "type": "object",
      "x-rust-derive": [
        "Debug",
        "Clone",
        "PartialEq",
        "Eq",
        "Serialize",
        "Deserialize"
      ],
      "required": [
        "module"
      ],
      "properties": {
        "module": {
          "type": "string",
          "format": "relative-path",
          "description": "Path inside the package, e.g. `frontend/index.mjs`."
        },
        "style": {
          "type": "string",
          "format": "relative-path",
          "description": "Linked on activation (SPEC §6.4)."
        }
      }
    },
    "PluginCapabilities": {
      "type": "object",
      "x-rust-derive": [
        "Debug",
        "Clone",
        "Default",
        "PartialEq",
        "Eq",
        "Serialize",
        "Deserialize"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "description": "Gates the server-side document host functions (SPEC §6.2). Unknown strings are refused rather than read as \"no access\"."
        },
        "http": {
          "$ref": "#/$defs/HttpCapability",
          "description": "Outbound HTTP, per declared hosts. No wildcards."
        },
        "notifications": {
          "type": "boolean",
          "description": "Native-bridge notifications (frontend-side, SPEC §7)."
        },
        "public-routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Unauthenticated routes under `/api/plugins/<id>`, shown at install. Each must also appear in `backend.routes`."
        }
      }
    },
    "HttpCapability": {
      "type": "object",
      "x-rust-derive": [
        "Debug",
        "Clone",
        "Default",
        "PartialEq",
        "Eq",
        "Serialize",
        "Deserialize"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-rust-always": true,
          "description": "Bare host names, matched exactly."
        }
      }
    },
    "PluginConfigField": {
      "type": "object",
      "x-rust-name": "ConfigField",
      "x-rust-derive": [
        "Debug",
        "Clone",
        "PartialEq",
        "Eq",
        "Serialize",
        "Deserialize"
      ],
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "select"
          ],
          "x-rust-field": "kind",
          "x-rust-type": "String",
          "description": "`string` | `number` | `boolean` | `select`."
        },
        "secret": {
          "type": "boolean",
          "description": "Write-only in the admin UI, encrypted at rest (SPEC §6.2)."
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "description": "Shown as the field's placeholder and used when nothing is set. Never applied to a secret."
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For `select`."
        }
      }
    },
    "PluginBackend": {
      "type": "object",
      "x-rust-derive": [
        "Debug",
        "Clone",
        "Default",
        "PartialEq",
        "Eq",
        "Serialize",
        "Deserialize"
      ],
      "x-removed": {
        "calls": "was removed in @kernel 3.0: list the callee under the manifest's `dependencies`"
      },
      "required": [
        "module"
      ],
      "properties": {
        "module": {
          "type": "string",
          "format": "relative-path",
          "description": "Path inside the package, conventionally `backend.wasm`. The only file outside `frontend/**` the installer extracts."
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "document.created",
              "document.changed",
              "document.deleted"
            ]
          },
          "description": "Document hooks (SPEC §6.3)."
        },
        "cron": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Five-field UTC cron expressions (SPEC §6.3)."
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`\"POST /webhook\"`: method and path, space separated."
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Server-bus events delivered to `lm_event`, namespaced (`other-plugin:something`)."
        },
        "exports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BackendExport"
          },
          "description": "Functions this backend's `lm_call` answers for plugins that depend on it (HOST-ABI.md §3.10). A call to a name not listed is refused; `input`/`output` shapes are checked at the boundary."
        }
      }
    },
    "BackendExport": {
      "type": "object",
      "x-rust-derive": [
        "Debug",
        "Clone",
        "PartialEq",
        "Eq",
        "Serialize",
        "Deserialize"
      ],
      "properties": {
        "input": {
          "description": "Shape JSON (`@kernel` `s.*`, serialized) the payload must fit. Absent: anything."
        },
        "output": {
          "description": "Shape JSON the returned value must fit. Absent: anything."
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
