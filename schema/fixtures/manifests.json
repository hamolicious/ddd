  {
    "name": "a full manifest",
    "manifest": {
      "id": "graph",
      "version": "2.0.0",
      "name": "Graph view",
      "description": "Notes and links.",
      "author": "ddd base distribution",
      "license": "MIT OR Apache-2.0",
      "x-tailwind": {
        "prefix": "graph"
      },
      "kernel": "^3.0",
      "peerLibraries": {
        "react": "^18.0.0"
      },
      "frontend": {
        "module": "frontend/index.mjs",
        "style": "frontend/style.css"
      },
      "dependencies": {
