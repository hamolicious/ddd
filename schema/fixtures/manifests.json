  {
    "name": "backend half and config",
    "manifest": {
      "id": "hello-backend",
      "version": "0.1.0+build.7",
      "kernel": "*",
      "capabilities": {
        "documents": [
          "read",
          "write"
        ],
        "http": {
          "hosts": [
            "example.com"
          ]
        },
        "notifications": true,
        "public-routes": [
          "/webhook"
        ]
      },
      "config": {
        "token": {
          "type": "string",
          "secret": true,
          "required": true
        },
        "mode": {
          "type": "select",
          "options": [
            "a",
            "b"
          ],
          "default": "a"
        },
        "limit": {
          "type": "number",
          "default": 3
        }
      },
      "backend": {
        "module": "backend.wasm",
        "hooks": [
          "document.created"
        ],
        "cron": [
          "*/5 * * * *"
        ],
        "routes": [
          "POST /webhook"
        ],
        "events": [
          "other:thing"
        ],
        "exports": {
          "normalize": {
            "input": {
              "object": {
                "title": "string",
                "tags": {
                  "optional": {
                    "array": "string"
                  }
                }
              }
            },
            "output": "string",
            "description": "Tidy a title."
          },
          "ping": {}
        }
      },
      "dependencies": {
        "calendar": "^1.0"
      }
    },
    "problems": []
  },
