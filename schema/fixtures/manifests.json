  {
    "name": "removed in @kernel 3.0: consumes, hot, object-form provides and backend.calls",
    "manifest": {
      "id": "graph",
      "version": "2.0.0",
      "kernel": "^2.0",
      "hot": true,
      "consumes": {
        "index": {
          "protocol": "ddd/workspace-index@^1.0"
        }
      },
      "provides": {
        "view": {
          "protocol": "ddd/main.view@1.0.0"
        }
      },
      "backend": {
        "module": "backend.wasm",
        "calls": [
          "other"
        ]
      }
    },
    "problems": [
      "consumes",
      "hot",
      "provides",
      "backend.calls"
    ]
  },
