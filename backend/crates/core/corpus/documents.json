    {
      "name": "unsupported-yaml-features",
      "input": "---\nanchor: &a value\nalias: *a\ntagged: !!str x\nblock: |\nfolded: >\nmerged:\n<<: other\nlist:\n- item\n  indented: 1\nok: 1\n---\n",
      "expect": {
        "title": "Untitled",
        "fm": {
          "list": null,
          "merged": null,
          "ok": 1
        },
        "fm_parse_error": true,
        "plugins": {},
        "diagnostics": [
          {
            "kind": "unsupported_feature",
            "line": 2
          },
          {
            "kind": "unsupported_feature",
            "line": 3
          },
          {
            "kind": "unsupported_feature",
            "line": 4
          },
          {
            "kind": "unsupported_feature",
            "line": 5
          },
          {
            "kind": "unsupported_feature",
            "line": 6
          },
          {
            "kind": "unsupported_feature",
            "line": 8
          },
          {
            "kind": "unsupported_feature",
            "line": 10
          },
          {
            "kind": "malformed_line",
            "line": 11
          }
        ]
      }
    },
    {
      "name": "comments-and-blanks",
      "input": "---\n# a comment\n\ntitle: Commented # trailing comment\nhash: \"keeps # inside quotes\"\nonly: # nothing but a comment\n---\n",
      "expect": {
