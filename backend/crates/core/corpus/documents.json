{
  "_comment": "Conformance corpus for core::document::parse_document. Every case is data only; the harness lives in tests/conformance.rs. `fm` and `plugins` are compared against Value::to_json output, `frontmatter`/`body`/`sections_text` against the sliced spans (null = no such region), and `diagnostics` is an exact ordered list of {kind, line} when present.",
  "cases": [
    {
      "name": "spec-example",
      "input": "---\ntitle: Groceries\npath: home/lists\ndate: 2026-09-23\n---\n\n# Groceries\n\n- [ ] milk\n- [x] bread\n\n%%% calendar\nsource-uid: abc123@google.com\n%%%\n",
      "expect": {
        "title": "Groceries",
        "fm": {
          "date": "2026-09-23",
          "path": "home/lists",
          "title": "Groceries"
        },
        "fm_parse_error": false,
        "plugins": {
          "calendar": {
            "source-uid": "abc123@google.com"
          }
        },
        "frontmatter": "---\ntitle: Groceries\npath: home/lists\ndate: 2026-09-23\n---\n",
        "body": "\n# Groceries\n\n- [ ] milk\n- [x] bread\n\n",
        "sections_text": "%%% calendar\nsource-uid: abc123@google.com\n%%%\n",
        "diagnostics": []
      }
    },
    {
      "name": "no-frontmatter-no-sections",
      "input": "# Just a note\n\nSome text.\n",
      "expect": {
        "title": "Just a note",
        "fm": {},
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": null,
        "body": "# Just a note\n\nSome text.\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "empty-document",
      "input": "",
      "expect": {
        "title": "Untitled",
        "fm": {},
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": null,
        "body": "",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "whitespace-only-document",
      "input": "   \n\n\t\n",
      "expect": {
        "title": "Untitled",
        "fm": {},
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": null,
        "body": "   \n\n\t\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "fence-not-first-line",
      "input": "\n---\ntitle: nope\n---\n",
      "expect": {
        "title": "---",
        "fm": {},
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": null,
        "body": "\n---\ntitle: nope\n---\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "fence-with-trailing-space-is-not-a-fence",
      "input": "--- \ntitle: nope\n---\n",
      "expect": {
        "title": "---",
        "fm": {},
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": null,
        "body": "--- \ntitle: nope\n---\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "unterminated-frontmatter-fence",
      "input": "---\ntitle: Orphan\n\nbody\n",
      "expect": {
        "title": "---",
        "fm": {},
        "fm_parse_error": true,
        "plugins": {},
        "frontmatter": null,
        "body": "---\ntitle: Orphan\n\nbody\n",
        "sections_text": null,
        "diagnostics": [
          {
            "kind": "unterminated_fence",
            "line": 1
          }
        ]
      }
    },
    {
      "name": "empty-frontmatter-block",
      "input": "---\n---\nbody\n",
      "expect": {
        "title": "body",
        "fm": {},
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": "---\n---\n",
        "body": "body\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "frontmatter-closes-at-first-closing-fence",
      "input": "---\na: 1\n---\nbody\n---\nnot: frontmatter\n---\n",
      "expect": {
        "title": "body",
        "fm": {
          "a": 1
        },
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": "---\na: 1\n---\n",
        "body": "body\n---\nnot: frontmatter\n---\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "no-trailing-newline-anywhere",
      "input": "---\ntitle: Tight\n---",
      "expect": {
        "title": "Tight",
        "fm": {
          "title": "Tight"
        },
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": "---\ntitle: Tight\n---",
        "body": "",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "crlf-is-normalized",
      "input": "---\r\ntitle: Windows\r\n---\r\n\r\n# Windows\r\n\r\n%%% p\r\nk: 1\r\n%%%\r\n",
      "expect": {
        "title": "Windows",
        "fm": {
          "title": "Windows"
        },
        "fm_parse_error": false,
        "plugins": {
          "p": {
            "k": 1
          }
        },
        "frontmatter": "---\ntitle: Windows\n---\n",
        "body": "\n# Windows\n\n",
        "sections_text": "%%% p\nk: 1\n%%%\n",
        "diagnostics": []
      }
    },
    {
      "name": "lone-cr-is-a-newline",
      "input": "---\rtitle: Classic\r---\rbody\r",
      "expect": {
        "title": "Classic",
        "fm": {
          "title": "Classic"
        },
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": "---\ntitle: Classic\n---\n",
        "body": "body\n",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "bom-is-stripped",
      "input": "﻿---\ntitle: Byte order\n---\n",
      "expect": {
        "title": "Byte order",
        "fm": {
          "title": "Byte order"
        },
        "fm_parse_error": false,
        "plugins": {},
        "frontmatter": "---\ntitle: Byte order\n---\n",
        "body": "",
        "sections_text": null,
        "diagnostics": []
      }
    },
    {
      "name": "typed-scalars",
      "input": "---\nstr: hello\nquoted: \"12\"\nsingle: 'it''s'\nint: -42\nbig: 9223372036854775808\nfloat: 1.25\nexp: 1e3\nyes: true\nno: FALSE\nnothing: null\ntilde: ~\nblank:\nversion: v1.2.3\nurl: \"https://example.com/x\"\n---\n",
      "expect": {
        "title": "Untitled",
        "fm": {
          "big": 9.223372036854776e+18,
          "blank": null,
          "exp": 1000.0,
          "float": 1.25,
          "int": -42,
          "no": false,
          "nothing": null,
          "quoted": "12",
          "single": "it's",
          "str": "hello",
          "tilde": null,
          "url": "https://example.com/x",
          "version": "v1.2.3",
          "yes": true
        },
        "fm_parse_error": false,
        "plugins": {},
        "diagnostics": []
      }
    },
    {
      "name": "flow-collections",
      "input": "---\ntags: [work, home]\nempty: []\nnums: [1, 2.5, true, null]\nnested: {a: 1, b: [x, y]}\ntrailing: [a, b, ]\n---\n",
      "expect": {
        "title": "Untitled",
        "fm": {
          "empty": [],
          "nested": {
            "a": 1,
            "b": [
              "x",
              "y"
            ]
          },
          "nums": [
            1,
            2.5,
            true,
            null
          ],
          "tags": [
            "work",
            "home"
          ],
          "trailing": [
            "a",
            "b"
          ]
        },
        "fm_parse_error": false,
        "plugins": {},
        "diagnostics": []
      }
    },
    {
      "name": "duplicate-keys-last-wins",
      "input": "---\na: 1\nb: first\na: 2\nb: second\n---\n",
      "expect": {
        "title": "Untitled",
        "fm": {
          "a": 2,
          "b": "second"
        },
        "fm_parse_error": false,
        "plugins": {},
        "diagnostics": [
          {
            "kind": "duplicate_key",
            "line": 4
          },
          {
            "kind": "duplicate_key",
            "line": 5
          }
        ]
      }
    },
    {
      "name": "broken-quote-mid-edit",
      "input": "---\ntitle: \"Half open\nkeep: yes\n---\n\nbody\n",
      "expect": {
        "title": "body",
        "fm": {
          "keep": "yes"
        },
        "fm_parse_error": true,
        "plugins": {},
        "diagnostics": [
          {
            "kind": "invalid_value",
            "line": 2
          }
        ]
      }
    },
    {
      "name": "broken-bracket-mid-edit",
      "input": "---\ntags: [work, home\nkeep: 1\n---\n",
