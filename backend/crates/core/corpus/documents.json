        "fm": {
          "hash": "keeps # inside quotes",
          "only": null,
          "title": "Commented"
        },
        "fm_parse_error": false,
        "plugins": {},
        "diagnostics": []
      }
    },
    {
      "name": "dates-normalize-to-canonical",
      "input": "---\nplain: 2026-09-23\noffset: 2026-09-23T12:00:00+02:00\nspace: 2026-09-23 10:00\nnoseconds: 2026-09-23T10:00Z\nmicros: 2026-09-23T10:00:00.123456Z\nnotadate: 2026-13-45\nalmost: 2026-09-23 groceries\nlist: [2026-01-02, nope]\n---\n",
      "expect": {
        "title": "Untitled",
        "fm": {
          "almost": "2026-09-23 groceries",
          "list": [
            "2026-01-02",
            "nope"
          ],
          "micros": "2026-09-23T10:00:00.123Z",
          "noseconds": "2026-09-23T10:00:00.000Z",
          "notadate": "2026-13-45",
          "offset": "2026-09-23T10:00:00.000Z",
          "plain": "2026-09-23",
          "space": "2026-09-23T10:00:00.000Z"
        },
        "fm_parse_error": false,
        "plugins": {},
        "diagnostics": []
      }
    },
