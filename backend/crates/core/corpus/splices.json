    {
      "name": "section-write-mixes-update-insert-and-remove",
      "text": "body\n\n%%% calendar\na: 1\nb: 2\n%%%\n",
      "op": {
        "kind": "splice_section",
        "plugin": "calendar",
        "edits": [
          {
            "key": "b",
            "value": 9
          },
          {
            "key": "c",
            "value": "new"
          },
          {
            "key": "a",
            "value": null,
