{
  "_comment": "Conformance corpus for core::splice. Each case applies one operation to `text` and asserts the resulting document (`expect`) plus, optionally, the number of edits and the exact slices the edits replace (`replaced`). Every result is re-parsed so a splice can never produce a document the parser disagrees with.",
  "cases": [
    {
      "name": "set-existing-frontmatter-value",
      "text": "---\ntitle: Old\npath: home\n---\n\nbody\n",
      "op": {
        "kind": "set_fm",
        "key": "title",
        "value": "New"
      },
      "expect": "---\ntitle: New\npath: home\n---\n\nbody\n",
      "edits": 1,
      "replaced": [
        "Old"
      ]
    },
    {
      "name": "set-inserts-a-missing-key",
      "text": "---\ntitle: A\n---\nbody\n",
      "op": {
        "kind": "set_fm",
        "key": "path",
        "value": "home/lists"
      },
      "expect": "---\ntitle: A\npath: home/lists\n---\nbody\n",
      "edits": 1,
      "replaced": [
        ""
      ]
    },
    {
      "name": "set-fills-an-empty-value",
      "text": "---\npath:\n---\n",
      "op": {
        "kind": "set_fm",
        "key": "path",
        "value": "home"
      },
      "expect": "---\npath: home\n---\n",
      "edits": 1
    },
    {
      "name": "set-creates-the-block",
      "text": "# Note\n\ntext\n",
      "op": {
        "kind": "set_fm",
        "key": "title",
        "value": "Note"
      },
      "expect": "---\ntitle: Note\n---\n\n# Note\n\ntext\n",
      "edits": 1
    },
    {
      "name": "set-creates-the-block-in-an-empty-document",
      "text": "",
      "op": {
        "kind": "set_fm",
        "key": "title",
        "value": "Fresh"
      },
      "expect": "---\ntitle: Fresh\n---\n",
      "edits": 1
    },
    {
      "name": "set-quotes-a-value-that-would-change-type",
      "text": "---\na: 1\n---\n",
      "op": {
        "kind": "set_fm",
        "key": "a",
        "value": "true"
      },
      "expect": "---\na: \"true\"\n---\n",
      "edits": 1
    },
    {
      "name": "set-writes-a-flow-sequence",
      "text": "---\ntags: [old]\n---\n",
      "op": {
        "kind": "set_fm",
        "key": "tags",
        "value": [
          "work",
          "home"
        ]
      },
      "expect": "---\ntags: [work, home]\n---\n",
      "edits": 1
    },
    {
      "name": "set-replaces-an-expanded-sequence",
      "text": "---\ntags:\n  - old\n  - home\nnext: 1\n---\n",
      "op": {
        "kind": "set_fm",
        "key": "tags",
        "value": [
          "work"
        ]
      },
      "expect": "---\ntags: [work]\nnext: 1\n---\n",
      "edits": 1,
      "replaced": [
        "\n  - old\n  - home"
      ]
    },
    {
      "name": "remove-deletes-an-expanded-sequence",
      "text": "---\ntags:\n  - old\n  - home\nnext: 1\n---\n",
      "op": {
        "kind": "remove_fm",
        "key": "tags"
      },
      "expect": "---\nnext: 1\n---\n",
      "edits": 1,
      "replaced": [
        "tags:\n  - old\n  - home\n"
      ]
    },
    {
      "name": "set-targets-the-last-duplicate",
      "text": "---\na: 1\na: 2\n---\n",
      "op": {
        "kind": "set_fm",
        "key": "a",
        "value": 3
      },
      "expect": "---\na: 1\na: 3\n---\n",
      "edits": 1
    },
    {
      "name": "set-replaces-the-whole-value-span-including-a-trailing-comment",
      "text": "---\na: 1 # keep me\n---\n",
      "op": {
        "kind": "set_fm",
        "key": "a",
        "value": 2
      },
      "expect": "---\na: 2\n---\n",
      "edits": 1,
      "replaced": [
        "1 # keep me"
      ]
    },
    {
      "name": "remove-every-occurrence",
      "text": "---\na: 1\nb: 2\na: 3\n---\n",
      "op": {
        "kind": "remove_fm",
        "key": "a"
      },
      "expect": "---\nb: 2\n---\n",
      "edits": 2
    },
    {
      "name": "remove-a-missing-key-is-a-no-op",
      "text": "---\na: 1\n---\n",
      "op": {
        "kind": "remove_fm",
        "key": "zz"
      },
      "expect": "---\na: 1\n---\n",
      "edits": 0
    },
