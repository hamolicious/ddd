{
  "name": "@life-manager/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Life Manager web: the kernel contract (kernel-api), the kernel runtime and M2 substrate, the PWA (app/), the M2 demo page kept as a harness fixture, and the harnesses.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:app": "vite --config vite.app.config.ts",
    "build:app": "node scripts/build-app.mjs",
    "build:plugins": "node scripts/build-plugins.mjs",
    "kernel:dts": "node scripts/build-kernel-dts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:app": "playwright test --config playwright.app.config.ts",
    "harness:convergence": "vite-node harness/src/convergence.ts",
    "harness:perf": "vite-node harness/src/perf.ts",
    "wasm": "mise run wasm"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "idb": "^8.0.3",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1",
    "web-tree-sitter": "0.27.0"
  }
}
