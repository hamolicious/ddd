# Required. Signs sessions and invites; at least 32 bytes (openssl rand -base64 48).
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# MongoDB connection for `mise run dev`; compose sets its own.
MONGO_URI=mongodb://127.0.0.1:27017

# Database name.
MONGO_DATABASE=ddd

# Port the server listens on and compose publishes.
PORT=8080
# Host port compose publishes MongoDB on, for `mise run dev`.
MONGO_PORT=27017

# Extra origins allowed to use the API and sync, comma-separated (the Android app is 127.0.0.1:41847).
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:41847
# Extra hosts allowed on PORT, e.g. a LAN IP for a phone.
APP_ORIGIN_HOSTS=

# The public URL clients use; tightens the Android app's content security policy.
#PUBLIC_URL=https://ddd.example.com

# Largest attachment in bytes; 0 is no limit.
MAX_ATTACHMENT_BYTES=104857600

# Secure cookies; true whenever served over https.
COOKIE_SECURE=false

# Trust X-Forwarded-For for client IPs; only behind a proxy that is the only way in.
TRUST_PROXY_HEADERS=false

# Log output: json or pretty.
LOG_FORMAT=pretty
# Log levels.
RUST_LOG=info,ddd_server=debug

# Seconds to finish in-flight work on shutdown.
SHUTDOWN_GRACE_SECS=30

# Days a deleted note stays in the Trash.
TRASH_RETENTION_DAYS=30
# Days an invite stays valid.
INVITE_TTL_DAYS=7

# Days of inactivity before a session expires.
SESSION_IDLE_DAYS=30
# Days before a session expires regardless.
SESSION_ABSOLUTE_DAYS=180

# Failed logins allowed per window.
LOGIN_MAX_ATTEMPTS=10
# Login rate-limit window in seconds.
LOGIN_ATTEMPT_WINDOW_SECS=900

# Largest note in bytes; can only be lowered.
MAX_DOCUMENT_BYTES=1048576

# Milliseconds after an edit before a note's searchable copy is saved.
MATERIALIZE_DEBOUNCE_MS=500
# Seconds an idle open note stays in memory.
ROOM_IDLE_TIMEOUT_SECS=600

# Edit history kept per note before compaction, in bytes.
UPDATE_LOG_KEEP_BYTES=1048576
# Edit history kept per note before compaction, in entries.
UPDATE_LOG_KEEP_COUNT=200

# Compact a note's stored history above this size.
CRDT_COMPACT_THRESHOLD_BYTES=4194304
# Log a warning when a note's stored history passes this size.
CRDT_ALERT_THRESHOLD_BYTES=8388608

# Built web app to serve; unset makes the server API-only.
#WEB_DIST_DIR=web/app/dist

# Where installed plugins live.
PLUGINS_DIR=plugins/base/dist

# Plugin type definitions served at /kernel.d.ts.
KERNEL_DTS_PATH=web/kernel-api/dist/kernel.d.ts

# Safe mode: load no plugins at all.
DISABLE_PLUGINS=false

# Where uploaded plugins wait for approval; must sit beside PLUGINS_DIR, not inside it.
#PLUGIN_STAGING_DIR=plugins/base/dist.staging

# Folder watched for plugin .zip files to add as pending.
#PLUGIN_INBOX_DIR=plugins/inbox

# Key for plugin secrets at rest (openssl rand -hex 32); defaults to one derived from SESSION_SECRET.
#CONFIG_KEY=

# Longest a plugin call may run, in ms.
#PLUGIN_CALL_TIMEOUT_MS=5000
# Longest a plugin's scheduled job may run, in ms.
#PLUGIN_CRON_TIMEOUT_MS=60000
# Memory per plugin instance, in bytes.
#PLUGIN_MEMORY_BYTES=134217728
# Concurrent instances per plugin.
#PLUGIN_MAX_INSTANCES=4
# Failures in a row before a plugin is switched off.
#PLUGIN_BREAKER_THRESHOLD=5

# Timeout for a plugin's outbound HTTP request, in ms.
#PLUGIN_HTTP_TIMEOUT_MS=10000
# Largest HTTP response a plugin may receive, in bytes.
#PLUGIN_HTTP_MAX_RESPONSE_BYTES=10485760
# Private address ranges plugins may reach, e.g. a self-hosted service.
#PLUGIN_HTTP_ALLOW_CIDRS=10.1.2.0/24

# Run plugins' scheduled jobs; turn off on all but one server sharing a database.
#PLUGIN_ENABLE_CRON=true
