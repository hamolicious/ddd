# Copy to .env for docker compose, or export in your shell for `mise run dev`.
# Generate a secret with:  openssl rand -base64 48
#
# Every variable is described in backend/README.md ("Environment variables").
# Only the "required" ones have no default; delete any other line to use its default.

# ---- required -------------------------------------------------------------

# At least 32 bytes. Rotating it logs everyone out and voids outstanding invites
# and password-reset links.
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# Required for `mise run dev` (compose sets its own value for the container).
MONGO_URI=mongodb://127.0.0.1:27017

# ---- commonly changed -----------------------------------------------------

MONGO_DATABASE=ddd

# The server's port. Compose listens on it in the container and publishes it on
# the host; `mise run dev` listens on it; `mise run dev-hot` puts Vite on it and
# the server on PORT+1. http://localhost:PORT and http://127.0.0.1:PORT are
# always allowed origins, so changing the port is this one line.
PORT=8080
# Loopback host port compose publishes mongo on, for `mise run dev`.
MONGO_PORT=27017

# Comma-separated origin allowlist, used for CORS and the WebSocket origin check.
# Exact matches only: scheme://host[:port], no trailing slash, no wildcards.
# From an unlisted origin the page loads but never syncs (the socket gets 403).
# Already allowed without listing: http://localhost:PORT, http://127.0.0.1:PORT
# and http://<host>:PORT for each host in APP_ORIGIN_HOSTS. List anything else,
# such as an https domain or a Vite dev origin.
#
# http://127.0.0.1:41847 is the Android app, which serves its bundle from a local
# server on the phone. Keep it if you use the app; it is harmless otherwise.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:41847
# Extra hosts allowed on PORT, e.g. a LAN address: `192.168.0.69` allows
# http://192.168.0.69:PORT.
APP_ORIGIN_HOSTS=

# The one public URL clients reach this server at, e.g. https://ddd.example.com.
# Optional. Same syntax as one APP_ORIGIN entry; more than one fails at boot.
# Narrows the Content-Security-Policy the Android app uses (otherwise it allows
# any http/https/ws/wss host). Use the URL devices actually reach: an internal
# address here makes the app's policy block the real server.
#PUBLIC_URL=https://ddd.example.com

# Maximum attachment size. Default 100 MiB; 0 is no limit.
MAX_ATTACHMENT_BYTES=104857600

# Keep true when served over https; set false only for plain-http local use.
COOKIE_SECURE=false

# Where the client IP (used for login rate limiting and the IP shown on sessions
# and audit entries) comes from:
#   false - the connection's peer address; X-Forwarded-For / X-Real-IP ignored.
#   true  - the rightmost X-Forwarded-For hop (what one trusted proxy appended).
# Set true only when a reverse proxy is the only route to the server, or clients
# can forge their IP.
TRUST_PROXY_HEADERS=false

# `json` (default) or `pretty` (readable, for local use).
LOG_FORMAT=pretty
RUST_LOG=info,ddd_server=debug

# ---- tuning (defaults shown; safe to omit) --------------------------------

# Seconds to finish in-flight work after SIGTERM. Keep below compose's
# stop_grace_period / Kubernetes terminationGracePeriodSeconds.
SHUTDOWN_GRACE_SECS=30

# Trash retention and invite validity, in days.
TRASH_RETENTION_DAYS=30
INVITE_TTL_DAYS=7

# Session lifetimes in days: idle timeout, then hard limit.
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=180

# Login rate limit: attempts per window, window in seconds.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECS=900

# Maximum document size in bytes; can only be lowered below 1 MiB.
MAX_DOCUMENT_BYTES=1048576

# Delay (ms) before saving a document's readable copy after an edit, and how long
# (s) an idle open document stays in memory.
MATERIALIZE_DEBOUNCE_MS=500
ROOM_IDLE_TIMEOUT_SECS=600

# Per-document edit history kept before compaction. Lowering it loses no data.
UPDATE_LOG_KEEP_BYTES=1048576
UPDATE_LOG_KEEP_COUNT=200

# Document storage size thresholds: compact above the first, log a warning above
# the second.
CRDT_COMPACT_THRESHOLD_BYTES=4194304
CRDT_ALERT_THRESHOLD_BYTES=8388608

# ---- web app and plugins --------------------------------------------------

# The built web app (`mise run web-build`). Set it and the server serves the app
# itself; unset, the server is API-only (as with `mise run app`, where Vite
# serves the app). Its origin must then be allowed (see APP_ORIGIN), or the page
# loads and never syncs.
#WEB_DIST_DIR=web/app/dist

# Installed plugins: one directory per plugin per version, each holding
# manifest.json and frontend/. `mise run plugins` builds the base plugins here.
PLUGINS_DIR=plugins/base/dist

# The plugin type definitions served at /kernel.d.ts (`mise run kernel-dts`).
KERNEL_DTS_PATH=web/kernel-api/dist/kernel.d.ts

# Safe mode: clients get no plugins, and no plugin backend code, cron job or hook
# runs (/api/plugins/<id>/* returns 404). The way back in when a plugin breaks
# the app. Per client: ?safe=1 (base plugins only) or ?safe=bare.
DISABLE_PLUGINS=false

# Where uploaded plugins are unpacked and wait for admin approval. Must be a
# sibling of PLUGINS_DIR, not inside it.
#PLUGIN_STAGING_DIR=plugins/base/dist.staging

# Drop a plugin package (e.g. `my-plugin-1.2.0.zip`) here and it is added as
# pending approval. Unset means the folder is not watched.
#PLUGIN_INBOX_DIR=plugins/inbox

# Encrypts secret plugin settings at rest. 32 bytes, hex or base64
# (openssl rand -hex 32). Defaults to a key derived from SESSION_SECRET, so
# rotating SESSION_SECRET without this set makes stored plugin secrets
# unreadable and they must be re-entered. Set it if you store plugin secrets.
#CONFIG_KEY=

# Plugin resource limits. These can only be lowered.
#PLUGIN_CALL_TIMEOUT_MS=5000
#PLUGIN_CRON_TIMEOUT_MS=60000
#PLUGIN_MEMORY_BYTES=134217728
#PLUGIN_MAX_INSTANCES=4
#PLUGIN_BREAKER_THRESHOLD=5

# Plugin outbound HTTP limits. Each plugin can only reach the hosts it was
# approved for.
#PLUGIN_HTTP_TIMEOUT_MS=10000
#PLUGIN_HTTP_MAX_RESPONSE_BYTES=10485760

# Private, loopback, link-local, CGNAT and cloud-metadata addresses are blocked
# for plugins. List CIDRs here to let plugins reach a self-hosted service.
#PLUGIN_HTTP_ALLOW_CIDRS=10.1.2.0/24

# Turn off when running a second server against the same database, or every
# server fires every scheduled job.
#PLUGIN_ENABLE_CRON=true
