# Copy to .env for docker compose, or export in your shell for `mise run dev`.
# Generate a secret with:  openssl rand -base64 48
#
# Every variable the server reads is documented in dev-docs/resolved/OPERATIONS.md. Only the
# two marked "required" have no default; everything else can be deleted from this
# file and the server will pick a sane value.

# ---- required -------------------------------------------------------------

# Required. >= 32 bytes, no default. Keys the derivation of every stored
# credential id, so rotating it logs everyone out and voids outstanding invites
# and password-reset links (SPEC §5.2).
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# Required for `mise run dev` (compose sets its own value for the container).
MONGO_URI=mongodb://127.0.0.1:27017

# ---- commonly changed -----------------------------------------------------

MONGO_DATABASE=ddd

# The one port. Compose listens on it inside the container and publishes it on the
# host; `mise run dev` listens on it; `mise run dev-hot` puts Vite on it and the
# server on PORT+1; `mise run shell-install` reverses it to the phone. The server
# allows http://localhost:PORT and http://127.0.0.1:PORT by itself, so moving the
# port is this one line.
PORT=8080
# Host port (loopback) compose publishes mongo on, for `mise run dev`.
MONGO_PORT=27017

# Comma-separated origin allowlist. Exact matches only: scheme://host[:port], no
# trailing slash, no wildcards.
#
# This is BOTH the CORS allowlist and the mandatory WebSocket origin check
# (SPEC §4.3, PROTOCOL.md §1.2): an origin that is not listed is refused with 403
# *before* the upgrade authenticates. The server's own http://localhost:PORT and
# http://127.0.0.1:PORT are allowed without being listed, and so is
# http://<host>:PORT for every host in APP_ORIGIN_HOSTS, so the port lives in PORT
# alone. List here what does not follow PORT: a Vite dev origin, an https domain.
#
# `http://127.0.0.1:41847` is the Flutter shell (SPEC §7, `app/BRIDGE.md` §6). The shell
# serves the downloaded bundle from a loopback HTTP server so the page has a real secure
# origin, which makes every API call cross-origin. Without this entry the shell signs in
# (login is not origin-checked) and then never syncs — the exact failure the note at the
# bottom of this file describes, with a harder-to-guess cause. Harmless when no shell is
# installed: nothing else can hold that origin.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:41847
# Extra hosts allowed on PORT, for a phone on the LAN: `192.168.0.69` allows
# http://192.168.0.69:PORT, and follows PORT when it moves.
APP_ORIGIN_HOSTS=

# The single origin clients reach this server at, e.g. https://ddd.example.com.
# Optional; unset changes nothing.
#
# Not an allowlist and not APP_ORIGIN — that one answers "who may talk to me", this
# one answers "what URL am I reached at", which a TLS-unaware server behind an ingress
# cannot work out for itself. Same syntax as one APP_ORIGIN entry: scheme://host[:port],
# no path, no trailing slash. Two entries is a boot failure, not a silently-used first.
#
# Today exactly one thing consumes it: the CSP published in the Android shell's bundle
# manifest (`index_csp`, SPEC §7). That page is served by the device's own loopback
# server, so every API call is cross-origin to it and the fallback policy has to be
# scheme-wide (`connect-src 'self' https: http: wss: ws:`). Setting this narrows it to
# `'self' <PUBLIC_URL> <the wss:// spelling of it>`. Point it at the URL devices
# actually use — an internal address here publishes a policy that blocks the app.
# See dev-docs/resolved/OPERATIONS.md § The Android shell.
#PUBLIC_URL=https://ddd.example.com

# 100 MiB default (SPEC §3.5); 0 is no limit.
MAX_ATTACHMENT_BYTES=104857600

# Set false only for plain-http local development.
COOKIE_SECURE=false

# Where the client IP comes from: the per-IP login backoff (SPEC §5.2) and the
# `ip` on sessions and audit entries (SPEC §5.4) key off it.
#   false - the connection's peer address; X-Forwarded-For / X-Real-IP ignored.
#   true  - the RIGHTMOST X-Forwarded-For hop (what one trusted proxy appended).
# Leave false unless a reverse proxy is the only route to the server: a trusted
# header no proxy rewrites lets a client pick its own bucket and forge its origin.
TRUST_PROXY_HEADERS=false

# `json` (default, deployed) or `pretty` (local).
LOG_FORMAT=pretty
RUST_LOG=info,ddd_server=debug

# ---- tuning (defaults shown; safe to omit) --------------------------------
#
# As of M2 these all reach the storage engine: `DocStoreTuning::from_config` maps
# each one onto the field the engine consults, and
# backend/crates/server/tests/docstore_tuning.rs pins that mapping field by field.
# (In M1 they were validated at boot and then ignored.) The values below match the
# compiled-in defaults.

# Seconds SIGTERM has to drain in-flight work before the process exits (SPEC §8).
# Keep below compose's stop_grace_period / Kubernetes terminationGracePeriodSeconds.
SHUTDOWN_GRACE_SECS=30

# Trash retention and invite validity, in days (SPEC §3.5, §5.1).
TRASH_RETENTION_DAYS=30
INVITE_TTL_DAYS=7

# Rolling session lifetimes, in days (SPEC §5.2).
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=180

# Login backoff: attempts per window, window in seconds (SPEC §5.2).
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECS=900

# Document cap in bytes; may only be lowered below the shared core's 1 MiB.
MAX_DOCUMENT_BYTES=1048576

# Materialization debounce (ms) and hot-document eviction (s) — SPEC §3.5, §4.3.
MATERIALIZE_DEBOUNCE_MS=500
ROOM_IDLE_TIMEOUT_SECS=600

# Per-document update-log retention (SPEC §3.5). Correctness never depends on it.
UPDATE_LOG_KEEP_BYTES=1048576
UPDATE_LOG_KEEP_COUNT=200

# CRDT blob thresholds: compact above the first, alert above the second.
CRDT_COMPACT_THRESHOLD_BYTES=4194304
CRDT_ALERT_THRESHOLD_BYTES=8388608

# ---------------------------------------------------------------------------
# M3: serving the PWA and the plugin distribution (SPEC §6.4, §8)
# ---------------------------------------------------------------------------

# The built PWA. Set it and the server serves the app, the import map (inline,
# nonced) and the SPA fallback; leave it unset and the server is API-only, which is
# the right shape for `mise run app` (Vite serves the app and proxies /api here).
#
# Build it with `mise run web-build`.
#WEB_DIST_DIR=web/app/dist

# Installed plugins: one directory per plugin per version, each containing
# manifest.json and frontend/. `mise run plugins` writes the base distribution here.
PLUGINS_DIR=plugins/base/dist

# The generated plugin contract, served at /kernel.d.ts (`mise run kernel-dts`).
KERNEL_DTS_PATH=web/kernel-api/dist/kernel.d.ts

# Safe mode, server-side (SPEC §6.1): every client is told the plugin list is empty.
# The client-side equivalents are ?safe=1 (base plugins only) and ?safe=bare.
DISABLE_PLUGINS=false

# NOTE on APP_ORIGIN: when the server serves the PWA itself (WEB_DIST_DIR set), its
# own origin must be in the list, or the WebSocket upgrade is refused with 403
# before it authenticates (PROTOCOL.md §1.2) — the page loads and never syncs.

# ---------------------------------------------------------------------------
# M4: the backend plugin host and the install flow (SPEC §6.2, §6.3)
# ---------------------------------------------------------------------------

# Extraction and the *pending* set. A sibling of PLUGINS_DIR, never a child: a child
# would be scanned as a plugin directory, and a pending package must be unreachable
# until an admin approves it (approval is the rename into PLUGINS_DIR).
#PLUGIN_STAGING_DIR=plugins/base/dist.staging

# The second install path (SPEC §6.2): drop `my-plugin-1.2.0.zip` here and it is
# installed as *pending*. Unset means no watcher at all — deliberately, because a
# guessed relative default silently resolves somewhere surprising.
#PLUGIN_INBOX_DIR=plugins/inbox

# Encrypts `secret: true` plugin config values at rest. 32 bytes, hex or base64.
# Unset ⇒ derived from SESSION_SECRET — which means rotating SESSION_SECRET without
# setting this makes every stored plugin secret unreadable and the admin must re-enter
# them. Set it explicitly in any deployment that stores a secret it cannot re-type.
#   openssl rand -hex 32
#CONFIG_KEY=

# Resource limits (SPEC §6.3). Configuration may only *lower* these.
#PLUGIN_CALL_TIMEOUT_MS=5000
#PLUGIN_CRON_TIMEOUT_MS=60000
#PLUGIN_MEMORY_BYTES=134217728
#PLUGIN_MAX_INSTANCES=4
#PLUGIN_BREAKER_THRESHOLD=5

# Outbound HTTP (SPEC §6.2). Hosts come from each plugin's approved capability; these
# are the global ceilings.
#PLUGIN_HTTP_TIMEOUT_MS=10000
#PLUGIN_HTTP_MAX_RESPONSE_BYTES=10485760

# The one knob that *widens* the sandbox: CIDRs plugins may reach in addition to the
# public internet. Private, loopback, link-local, CGNAT and cloud-metadata addresses
# are refused by default; add a range here to reach a self-hosted service on purpose.
#PLUGIN_HTTP_ALLOW_CIDRS=10.1.2.0/24

# Cron off is for a second server pointed at one database (HA is v2) and for
# debugging — with it on, every replica would fire every job.
#PLUGIN_ENABLE_CRON=true

# NOTE: DISABLE_PLUGINS=1 also stops the backend host in M4 — nothing is compiled, no
# cron fires, no hook is delivered, and every /api/plugins/<id>/* route 404s.
